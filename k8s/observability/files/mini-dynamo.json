{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "uid": "mini-dynamo",
  "title": "Mini-Dynamo Overview",
  "tags": ["mini-dynamo"],
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "End-to-end latency (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(mdyn_request_latency_seconds_bucket{stage=\"e2e\"}[1m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(mdyn_request_latency_seconds_bucket{stage=\"e2e\"}[1m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Time to first token (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(mdyn_ttft_seconds_bucket[1m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(mdyn_ttft_seconds_bucket[1m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mdyn_tokens_total[1m]))", "legendFormat": "total" },
        { "refId": "B", "expr": "sum(rate(mdyn_tokens_total[1m])) by (node)", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests / sec by outcome (router)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mdyn_requests_total{service=\"router\"}[1m])) by (outcome)", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "mdyn_queue_depth", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active batch size",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "mdyn_active_batch_size", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "KV cache utilization",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "mdyn_cache_utilization_ratio", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "KV cache used (MB)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "mdyn_cache_used_mb", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Evictions / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mdyn_evictions_total[1m])) by (node)", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "KV transfer time (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(mdyn_kv_transfer_seconds_bucket[1m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(mdyn_kv_transfer_seconds_bucket[1m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Routing decisions / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mdyn_routing_decisions_total[1m])) by (kind)", "legendFormat": "{{kind}}" }
      ]
    }
  ]
}
