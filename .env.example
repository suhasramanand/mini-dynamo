# Copy to .env and tweak. These map 1:1 to common/config.py.

# --- Shared state ---
REDIS_URL=redis://localhost:6379/0

# --- Execution mode: disaggregated | colocated ---
MODE=disaggregated

# --- Simulated GPU memory ---
GPU_MEMORY_MB=4096
KV_MB_PER_TOKEN=0.5
EVICTION_POLICY=lru            # lru | fifo | none

# --- KV transfer cost model ---
KV_TRANSFER_BANDWIDTH_GBPS=25
KV_TRANSFER_FIXED_MS=2

# --- Mock model latency ---
PREFILL_BASE_MS=15
PREFILL_MS_PER_TOKEN=0.4
DECODE_MS_PER_TOKEN=12
LATENCY_JITTER=0.15

# --- Continuous batching ---
MAX_BATCH_SIZE=16
MAX_TOKENS_DEFAULT=64

# --- Observability ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
